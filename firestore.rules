rules_version = '2';

// Movement stores one document per member at users/{uid}, holding their
// profile, settings, and workout completion history (see
// Movement/FirestoreSyncService.swift for the exact shape). Every read/write
// must be the signed-in member acting on their own document — nobody else's.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
